@startuml use-case-model
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Hub volunteer" as Volunteer
actor "Hub staff member" as Staff
actor "Hub manager" as Manager
actor "Traceability\ncoordinator" as Trace

Staff -|> Volunteer
Manager -|> Staff

rectangle "Kerry Local Food Hub Stock and Order System" {
  usecase "UC-01 Record\nexpected delivery" as UC01
  usecase "UC-02 Receive\ndelivery" as UC02
  usecase "UC-11 Record\ntraceability details" as UC11
  usecase "UC-03 Release\nheld stock" as UC03
  usecase "UC-04 Record\ncustomer order" as UC04
  usecase "UC-05 Allocate\nstock to orders" as UC05
  usecase "UC-06 Handle\nshortfall" as UC06
  usecase "UC-07 Pack\norder" as UC07
  usecase "UC-08 Record\nhandover" as UC08
  usecase "UC-09 Trace\nitem" as UC09
  usecase "UC-10 View\nhub summary" as UC10
}

Volunteer -- UC02
Volunteer -- UC07
Staff -- UC01
Staff -- UC03
Staff -- UC04
Staff -- UC05
Staff -- UC08
Manager -- UC10
Trace -- UC09

UC02 ..> UC11 : <<include>>
UC06 ..> UC05 : <<extend>>
@enduml
